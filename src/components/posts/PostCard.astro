---
// Figma: Posts / Shared article card。自サイトと外部記事を同じレイアウトで扱う。
import { formatDate, type Post } from '../../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const external = post.sourceKind === 'external';
---

<a
  href={post.href}
  class="group flex flex-col bg-paper"
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <img
    src={post.thumbnail || '/images/noimage-v4.jpg'}
    alt=""
    loading="lazy"
    decoding="async"
    class="aspect-video w-full object-cover"
  />
  <div class="flex flex-col gap-3 p-4 pc:p-5">
    <div class="flex items-center justify-between gap-2 text-muted">
      <span class="inline-flex items-center gap-1 text-[12px] leading-[1.6] pc:gap-1.5 pc:font-medium">
        {post.sourceName}
        {external && <span class="text-caption font-normal" aria-label="外部サイト">↗</span>}
      </span>
      <time class="text-caption" datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
    </div>
    <h3 class="text-action font-medium group-hover:underline max-pc:text-[18px] max-pc:leading-[1.55] pc:min-h-[81px]">{post.title}</h3>
    {post.description && <p class="line-clamp-3 text-[14px] leading-[1.7] text-muted pc:text-[16px] pc:leading-[1.5]">{post.description}</p>}
  </div>
</a>
