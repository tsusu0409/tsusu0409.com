---
// POSTS一覧の1ページ分（並び順・年ごとの全ページで共用）。Figma: POSTS / Index · 12 articles, Pagination
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from './PostCard.astro';
import { pageHref, paginate, type ListQuery, type Post } from '../../lib/posts';

interface Props extends ListQuery {
  page: ReturnType<typeof paginate<Post>>;
  /** 絞り込みに出す年（新しい順） */
  years: string[];
}

const { page, years, ...query } = Astro.props;
const { year, oldest } = query;
const numbers = Array.from({ length: page.pages }, (_, i) => i + 1);
const prev = page.page > 1 ? pageHref(page.page - 1, query) : null;
const next = page.page < page.pages ? pageHref(page.page + 1, query) : null;
// スマホ版は枠線なしの白いボタン、現在ページは濃色（Figma: Mobile / Pagination button）
const cell = 'flex size-11 items-center justify-center text-action font-medium pc:size-12 pc:border pc:border-line';
const plain = 'bg-paper pc:bg-transparent';
const disabled = [plain, 'opacity-35 pc:text-muted pc:opacity-40'];
---

<!-- 古い順は新しい順と内容が重複するので検索結果には出さない -->
<BaseLayout title={`POSTS${year ? ` ${year}` : ''}${page.page === 1 ? '' : ` (${page.page}/${page.pages})`}`} description="自サイトと外部サイトに投稿した記事の一覧です。" image="/og/blog.png" noindex={oldest}>
  <section class="flex flex-col gap-4 pc:gap-6">
    <h1 class="text-sub font-medium max-pc:text-[28px]">POSTS</h1>
    <p class="text-body max-pc:text-muted">自サイトと外部サイトに投稿した記事をまとめています。</p>
    <div class="text-small flex justify-between text-muted max-pc:text-[12px] max-pc:leading-[1.6]">
      <p>{page.from}–{page.to} / {page.total}</p>
      <div class="flex gap-4">
        <select data-post-nav aria-label="公開年で絞り込み" class="cursor-pointer bg-transparent">
          <option value={pageHref(1, { oldest })} selected={!year}>すべての年</option>
          {years.map((y) => <option value={pageHref(1, { year: y, oldest })} selected={y === year}>{y}年</option>)}
        </select>
        <select data-post-nav aria-label="並び順" class="cursor-pointer bg-transparent">
          <option value={pageHref(1, { year })} selected={!oldest}>新しい順</option>
          <option value={pageHref(1, { year, oldest: true })} selected={oldest}>古い順</option>
        </select>
      </div>
    </div>
  </section>

  <div class="grid gap-6 pc:grid-cols-3 pc:gap-8">
    {page.items.map((post) => <PostCard post={post} />)}
  </div>

  {page.pages > 1 && (
    <nav class="flex flex-col items-center gap-3 pc:gap-4" aria-label="ページ送り">
      <div class="flex flex-wrap justify-center gap-2 pc:gap-3">
        {prev ? <a href={prev} class:list={[cell, plain]} aria-label="前のページ">←</a> : <span class:list={[cell, disabled]} aria-hidden="true">←</span>}
        {numbers.map((n) =>
          n === page.page
            ? <span class:list={[cell, 'bg-ink text-paper pc:bg-blue pc:text-ink']} aria-current="page">{n}</span>
            : <a href={pageHref(n, query)} class:list={[cell, plain, 'pc:hover:bg-paper']}>{n}</a>
        )}
        {next ? <a href={next} class:list={[cell, plain]} aria-label="次のページ">→</a> : <span class:list={[cell, disabled]} aria-hidden="true">→</span>}
      </div>
      <p class="text-label font-medium text-muted max-pc:text-[12px] max-pc:leading-[1.6] max-pc:font-normal">{page.page} / {page.pages}</p>
    </nav>
  )}
</BaseLayout>

<script>
  document.querySelectorAll<HTMLSelectElement>('[data-post-nav]').forEach((select) => {
    select.addEventListener('change', () => location.assign(select.value));
  });
</script>
