---
// 未知URL・廃止したGymKusa等の404。Figma: 404 / Page not found
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ページが見つかりません" noindex>
  <section class="flex min-h-[calc(100svh-480px)] items-center gap-16 py-16">
    <div class="flex w-[360px] flex-none flex-col gap-4 font-medium">
      <p class="text-[156px] leading-none tracking-[-0.04em] text-accent">404</p>
      <p class="text-label text-muted">PAGE NOT FOUND</p>
    </div>
    <div class="flex flex-col gap-8">
      <div class="flex flex-col gap-6">
        <h1 class="text-heading font-medium">ページが見つかりません</h1>
        <p class="text-body text-muted">お探しのページは、移動・削除されたか、<br />現在公開していません。</p>
      </div>
      <a href="/" class="text-link w-[200px] bg-blue px-6 py-4 font-medium hover:bg-accent">TOPに戻る →</a>
      <div class="text-link flex gap-10 font-medium">
        <a href="/blog/" class="w-[120px] hover:underline">POSTS →</a>
        <a href="/playlist/" class="w-[152px] hover:underline">PLAYLIST →</a>
      </div>
    </div>
  </section>
</BaseLayout>
