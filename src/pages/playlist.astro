---
// Playlist: 月ごとのSpotifyプレイリスト。初期表示はデータ内の最新月（静的HTML）、?month=YYYY.MM で切替。
// Figma: PLAYLIST / Selected month
import BaseLayout from '../layouts/BaseLayout.astro';
import playlistsData from '../data/spotify-playlists.json';
import { archiveRows, toMonths, type RawPlaylist } from '../lib/playlist';

const months = toMonths(playlistsData as unknown as RawPlaylist[]);
const rows = archiveRows(months.map((m) => m.key));
const latest = months[0]?.key;
const cell = 'flex h-9 w-16 items-center justify-center text-[16px] leading-[1.75]';
---

<BaseLayout title="Playlist" description="1ヶ月に1度、その月にお気に入りだった楽曲をまとめたプレイリストです。" gap="gap-12">
  <h1 class="text-sub font-medium">Playlist</h1>

  {months.length === 0 && <p class="text-body text-muted">公開中のプレイリストはありません。</p>}

  {months.map((month) => (
    <section class="flex gap-12" data-month={month.key} hidden={month.key !== latest}>
      <div class="flex w-80 flex-none flex-col gap-6">
        <h2 class="text-sub font-medium">{month.key}</h2>
        <p class="text-small text-muted">{month.tracks.length} tracks / {month.duration}</p>
        {month.covers.length > 0 && (
          <div class="grid grid-cols-2">
            {Array.from({ length: 4 }, (_, i) => month.covers[i % month.covers.length]).map((src) => (
              <img src={src} alt="" width="160" height="160" loading="lazy" class="size-40 object-cover" />
            ))}
          </div>
        )}
        {month.spotifyUrl && (
          <a href={month.spotifyUrl} target="_blank" rel="noopener noreferrer" class="text-link bg-blue p-3 text-center font-medium hover:bg-accent">
            Spotifyで聴く ↗
          </a>
        )}
      </div>

      <div class="flex flex-1 flex-col">
        <p class="text-label font-medium text-muted">TRACKS</p>
        <ol>
          {month.tracks.map((track, i) => (
            <li class="flex items-center gap-6 border-b border-line py-3 last:border-b-0">
              <span class="text-caption w-6 text-muted leading-[1.75]">{String(i + 1).padStart(2, '0')}</span>
              {track.image
                ? <img src={track.image} alt={track.album} width="56" height="56" loading="lazy" class="size-14 flex-none object-cover" />
                : <span class="size-14 flex-none bg-blue" aria-hidden="true"></span>}
              <div class="flex min-w-0 flex-col gap-1">
                {track.url
                  ? <a href={track.url} target="_blank" rel="noopener noreferrer" class="text-link font-medium hover:underline">{track.name}</a>
                  : <span class="text-link font-medium">{track.name}</span>}
                <span class="text-caption text-muted leading-[1.75]">{track.artists}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  ))}

  <section class="flex flex-col gap-6">
    <h2 class="text-label font-medium text-muted">ARCHIVE</h2>
    <div class="flex flex-col gap-3">
      {rows.map((row) =>
        row.type === 'gap' ? (
          <p class="text-link w-24 text-center font-medium" aria-hidden="true">⋮</p>
        ) : (
          <div class="flex items-center gap-6">
            <p class="text-link w-24 text-center font-medium">{row.year}</p>
            <div class="flex gap-3">
              {row.months.map((m) =>
                m.enabled ? (
                  <a
                    href={`/playlist/?month=${m.key}`}
                    data-month-link={m.key}
                    class:list={[cell, 'text-muted hover:bg-paper aria-[current=true]:bg-blue aria-[current=true]:text-ink']}
                    aria-current={m.key === latest ? 'true' : undefined}
                    aria-label={m.key}
                  >{m.label}</a>
                ) : (
                  <span class:list={[cell, 'text-muted opacity-35']} aria-hidden="true">{m.label}</span>
                )
              )}
            </div>
          </div>
        )
      )}
    </div>
  </section>
</BaseLayout>

<script>
  const sections = document.querySelectorAll<HTMLElement>('[data-month]');
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-month-link]');
  const latest = sections[0]?.dataset.month;

  function show(month: string | null) {
    const target = [...sections].some((s) => s.dataset.month === month) ? month : latest;
    sections.forEach((s) => (s.hidden = s.dataset.month !== target));
    links.forEach((a) => (a.dataset.monthLink === target ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
  }

  links.forEach((a) =>
    a.addEventListener('click', (event) => {
      event.preventDefault();
      history.pushState(null, '', a.href);
      show(a.dataset.monthLink!);
    }),
  );
  window.addEventListener('popstate', () => show(new URLSearchParams(location.search).get('month')));
  show(new URLSearchParams(location.search).get('month'));
</script>
