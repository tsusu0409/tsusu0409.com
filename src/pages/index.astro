---
// TOP: 名刺（First view）→ ABOUT → POSTS → CONTENTS。Figma: TOP / 01 First view, TOP / 02
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import PostCard from '../components/posts/PostCard.astro';
import { getAllPosts } from '../lib/getPosts';

const latest = (await getAllPosts()).slice(0, 3);

const work = [{ name: '株式会社Kaizen Platform', period: '2026.03 - now' }];
const education = [
  { name: '筑波大学 理工学群', period: '2023.04 - now' },
  { name: '千葉県立東葛飾高等学校 95期生', period: '2020.04 - 2023.03' },
  { name: '千葉県立東葛飾中学校 2期生', period: '2017.04 - 2020.03' },
];
const contents = [
  {
    label: 'MUSIC',
    title: 'Playlist',
    icon: '/images/v4/icon-music.svg',
    text: '1ヶ月に1度、その月にお気に入りだった楽曲をまとめたプレイリストを公開しています。',
    href: '/playlist/',
    cta: 'プレイリストを見る →',
  },
  {
    label: 'COOKING',
    title: 'Recipes',
    icon: '/images/v4/icon-cooking.svg',
    text: '普段の自炊で作っている料理のレシピをまとめています。',
    href: '/recipes/',
    cta: 'レシピを見る →',
  },
];
---

<BaseLayout header={false} gap="gap-[72px]">
  <!-- First view: 名刺 -->
  <section class="flex min-h-[calc(100svh-48px)] flex-col">
    <Header />
    <div class="mt-[23px] flex min-h-[640px] bg-paper shadow-[0_16px_20px_rgba(31,56,66,0.08)]">
      <div class="flex w-[360px] flex-none items-center justify-center bg-blue p-8">
        <img src="/images/v4/portrait.jpg" alt="川岸 翼" width="296" height="446" class="h-[446px] w-[296px] object-cover" />
      </div>
      <div class="flex flex-1 flex-col gap-[22px] p-[60px]">
        <h1 class="text-[64px] leading-[1.5] font-medium">川岸 翼</h1>
        <p class="text-[22px] leading-[1.5] text-muted">KAWAGISHI Tsubasa</p>
        <hr class="border-line" />
        <p class="text-label font-medium text-muted">AFFILIATION</p>
        <p class="text-[22px] leading-[1.5]">
          筑波大学 理工学群 応用理工学類<br />電子・量子工学主専攻<br />超ワイドギャップ半導体研究室B4
        </p>
        <p class="text-label font-medium text-muted">COMMUNITY</p>
        <p class="text-[22px] leading-[1.5]">INVERHOUSE #24<br />jsys23, 24</p>
      </div>
    </div>
    <div class="flex min-h-24 flex-1 items-center justify-center">
      <a href="#about" class="p-2" aria-label="ABOUTへ移動">
        <img src="/images/v4/chevron-down.svg" width="32" height="32" alt="" />
      </a>
    </div>
  </section>

  <section id="about" class="flex scroll-mt-12 flex-col gap-8">
    <h2 class="text-sub font-medium">ABOUT</h2>
    <div class="flex items-start gap-16">
      <div class="flex w-[296px] flex-none flex-col gap-4 bg-paper p-8">
        <p class="text-sub font-medium">川岸翼 / Tsusu</p>
        <p class="text-small text-muted">@tsusu0409</p>
      </div>
      <div class="flex w-[760px] flex-col gap-8">
        <div class="text-body flex flex-col gap-6">
          <p>筑波大学の学生です。</p>
          <p>アルティメットが好きで、<br />サークルでもアルティメットをしています。</p>
          <p>趣味でパソコンを触っています。<br />最近は千葉ロッテマリーンズが好きです。</p>
        </div>
        <hr class="border-line" />
        {[{ label: 'WORK', items: work }, { label: 'EDUCATION', items: education }].map((group) => (
          <dl class="flex flex-col gap-3">
            <dt class="text-label font-medium text-muted">{group.label}</dt>
            {group.items.map((item) => (
              <dd class="flex flex-col gap-2 leading-[1.75]">
                <span class="text-[18px] font-medium">{item.name}</span>
                <span class="text-[16px] text-muted">{item.period}</span>
              </dd>
            ))}
          </dl>
        ))}
      </div>
    </div>
  </section>

  <section class="flex flex-col gap-8">
    <div class="flex items-end justify-between">
      <h2 class="text-sub font-medium">POSTS</h2>
      <a href="/blog/" class="text-link font-medium hover:underline">ブログ一覧へ →</a>
    </div>
    <div class="grid grid-cols-3 gap-8">
      {latest.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="flex flex-col gap-8">
    <h2 class="text-sub font-medium">CONTENTS</h2>
    <div class="grid grid-cols-2 gap-8">
      {contents.map((item) => (
        <div class="flex flex-col gap-6 bg-paper p-8">
          <div class="flex items-center gap-6">
            <img src={item.icon} width="40" height="40" alt="" class="size-10 object-contain" />
            <div class="flex flex-col gap-2 font-medium">
              <p class="text-label text-muted">{item.label}</p>
              <h3 class="text-sub">{item.title}</h3>
            </div>
          </div>
          <p class="text-small min-h-16 text-muted">{item.text}</p>
          <hr class="border-line" />
          <a href={item.href} class="text-link w-fit font-medium hover:underline">{item.cta}</a>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
