---
// 旧 /activity/ の互換ページ（メインナビには載せない）。既存8件を静的HTMLの details で表示する。
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const activities = await Promise.all(
  (await getCollection('activity'))
    .sort((a, b) => b.id.localeCompare(a.id))
    .map(async (entry) => ({ ...entry, Content: (await render(entry)).Content })),
);
---

<BaseLayout title="Activities" description="これまでの活動歴を掲載しています。">
  <section class="flex flex-col gap-6">
    <h1 class="text-sub font-medium">ACTIVITIES</h1>
    <p class="text-body text-muted">これまでの活動歴や作成したコンテンツを掲載しています。</p>
  </section>
  <div class="flex flex-col gap-4">
    {activities.map(({ data, Content }) => (
      <details class="bg-paper p-6">
        <summary class="flex cursor-pointer flex-col gap-1">
          <span class="text-caption text-muted">{data.startDate} - {data.endDate ?? 'now'}</span>
          <span class="text-sub font-medium">{data.title}</span>
          <span class="text-small text-muted">{data.description}</span>
        </summary>
        <div class="markdown text-small mt-6 border-t border-line pt-6">
          <Content />
        </div>
      </details>
    ))}
  </div>
</BaseLayout>
