---
// レシピ詳細（B案）: 中央800pxの1列。概要 → 写真 → 材料 → 手順 → NOTES。Figma: RECIPE DETAIL / Article · Selected B
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MarkdownEnhance from '../../components/posts/MarkdownEnhance.astro';
import { RECIPE_CATEGORIES } from '../../content.config';
import { isPublished } from '../../lib/getPosts';

export async function getStaticPaths() {
  return (await getCollection('recipes', isPublished)).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const hasNotes = entry.body?.trim();
---

<BaseLayout title={data.title} description={data.description} image={`/og/recipes/${entry.id}.png`} type="article">
  <p class="text-caption text-muted max-pc:text-[11px] max-pc:leading-[1.5] max-pc:font-medium">
    <a href="/recipes/" class="hover:underline">RECIPES</a> / {data.title}
  </p>

  <article class="mx-auto flex w-full flex-col gap-8 pc:w-[800px] pc:gap-12">
    <header class="flex flex-col gap-4 pc:gap-6">
      <p class="text-label font-medium text-muted">{RECIPE_CATEGORIES[data.category]}</p>
      <h1 class="text-heading font-medium">{data.title}</h1>
      <p class="text-small text-muted max-pc:text-[16px] max-pc:leading-[1.8] max-pc:text-ink">{data.description}</p>
      <dl class="flex gap-3 font-medium pc:gap-12">
        <div class="flex flex-1 flex-col gap-1 pc:w-40 pc:flex-none pc:gap-3">
          <dt class="text-label text-muted">TIME</dt>
          <dd class="text-sub max-pc:text-[18px]">{data.cookMinutes}分</dd>
        </div>
        <div class="flex flex-1 flex-col gap-1 pc:w-40 pc:flex-none pc:gap-3">
          <dt class="text-label text-muted">SERVES</dt>
          <dd class="text-sub max-pc:text-[18px]">{data.servings}</dd>
        </div>
      </dl>
    </header>

    <img src={data.image} alt={data.imageAlt} width="800" height="450" class="aspect-video h-auto w-full object-cover pc:aspect-auto pc:h-[450px]" />

    <section class="flex flex-col gap-5 pc:gap-8">
      <div class="flex items-center justify-between pc:items-baseline">
        <h2 class="text-sub font-medium">INGREDIENTS</h2>
        <p class="text-caption text-muted">{data.servings}</p>
      </div>
      <div class="grid gap-5 pc:grid-cols-2 pc:gap-x-24 pc:gap-y-8">
        {data.ingredientGroups.map((group) => (
          <div class="flex flex-col gap-2 pc:gap-3">
            <h3 class="text-label font-medium text-muted">{group.title}</h3>
            <ul>
              {group.items.map((item) => (
                <li class="text-small flex justify-between gap-4 border-b border-line py-3">
                  <span>{item.name}</span>
                  <span class="text-right">{item.amount}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="flex flex-col gap-6 pc:gap-8">
      <h2 class="text-sub font-medium">METHOD</h2>
      <!-- スマホ版は番号（32pxの四角）と手順名を横に並べ、本文は全幅（Figma: Mobile / Method step） -->
      <ol class="flex flex-col gap-6 pc:gap-8">
        {data.steps.map((step, i) => (
          <li class="grid grid-cols-[32px_1fr] items-center gap-3 pc:flex pc:items-start pc:gap-6 pc:border-b pc:border-line pc:pb-4">
            <span class="flex size-8 items-center justify-center bg-blue text-[12px] leading-[1.6] pc:block pc:size-auto pc:w-10 pc:flex-none pc:bg-transparent pc:text-sub pc:font-medium pc:text-accent">{String(i + 1).padStart(2, '0')}</span>
            <div class="contents pc:flex pc:flex-col pc:gap-3">
              <h3 class="text-sub font-medium max-pc:text-[18px]">{step.title}</h3>
              <p class="text-small max-pc:col-span-2 max-pc:text-[16px] max-pc:leading-[1.8]">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    {hasNotes && (
      <section class="flex flex-col gap-4 pc:gap-6">
        <h2 class="text-sub font-medium">NOTES</h2>
        <div class="markdown text-small text-muted max-pc:text-[16px] max-pc:leading-[1.8] max-pc:text-ink">
          <Content />
        </div>
      </section>
    )}

    <div class="flex flex-col gap-4 pc:gap-6">
      <hr class="border-line" />
      <a href="/recipes/" class="text-action w-fit font-medium text-link hover:underline">← レシピ一覧に戻る</a>
    </div>
  </article>

  <MarkdownEnhance />
</BaseLayout>
