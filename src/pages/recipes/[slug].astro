---
// レシピ詳細（B案）: 中央800pxの1列。概要 → 写真 → 材料 → 手順 → NOTES。Figma: RECIPE DETAIL / Article · Selected B
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MarkdownEnhance from '../../components/posts/MarkdownEnhance.astro';
import { RECIPE_CATEGORIES } from '../../content.config';
import { isPublished } from '../../lib/getPosts';

export async function getStaticPaths() {
  return (await getCollection('recipes', isPublished)).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const hasNotes = entry.body?.trim();
---

<BaseLayout title={data.title} description={data.description} image={data.image} type="article">
  <p class="text-caption text-muted">
    <a href="/recipes/" class="hover:underline">RECIPES</a> / {data.title}
  </p>

  <article class="mx-auto flex w-[800px] flex-col gap-12">
    <header class="flex flex-col gap-6">
      <p class="text-label font-medium text-muted">{RECIPE_CATEGORIES[data.category]}</p>
      <h1 class="text-heading font-medium">{data.title}</h1>
      <p class="text-small text-muted">{data.description}</p>
      <dl class="flex gap-12 font-medium">
        <div class="flex w-40 flex-col gap-3">
          <dt class="text-label text-muted">TIME</dt>
          <dd class="text-sub">{data.cookMinutes}分</dd>
        </div>
        <div class="flex w-40 flex-col gap-3">
          <dt class="text-label text-muted">SERVES</dt>
          <dd class="text-sub">{data.servings}</dd>
        </div>
      </dl>
    </header>

    <img src={data.image} alt={data.imageAlt} width="800" height="450" class="h-[450px] w-full object-cover" />

    <section class="flex flex-col gap-8">
      <div class="flex items-baseline justify-between">
        <h2 class="text-sub font-medium">INGREDIENTS</h2>
        <p class="text-caption text-muted">{data.servings}</p>
      </div>
      <div class="grid grid-cols-2 gap-x-24 gap-y-8">
        {data.ingredientGroups.map((group) => (
          <div class="flex flex-col gap-3">
            <h3 class="text-label font-medium text-muted">{group.title}</h3>
            <ul>
              {group.items.map((item) => (
                <li class="text-small flex justify-between gap-4 border-b border-line py-3">
                  <span>{item.name}</span>
                  <span class="text-right">{item.amount}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="flex flex-col gap-8">
      <h2 class="text-sub font-medium">METHOD</h2>
      <ol class="flex flex-col gap-8">
        {data.steps.map((step, i) => (
          <li class="flex gap-6 border-b border-line pb-4">
            <span class="text-sub w-10 flex-none font-medium text-accent">{String(i + 1).padStart(2, '0')}</span>
            <div class="flex flex-col gap-3">
              <h3 class="text-sub font-medium">{step.title}</h3>
              <p class="text-small">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    {hasNotes && (
      <section class="flex flex-col gap-6">
        <h2 class="text-sub font-medium">NOTES</h2>
        <div class="markdown text-small text-muted">
          <Content />
        </div>
      </section>
    )}

    <div class="flex flex-col gap-6">
      <hr class="border-line" />
      <a href="/recipes/" class="text-link w-fit font-medium hover:underline">← レシピ一覧に戻る</a>
    </div>
  </article>

  <MarkdownEnhance />
</BaseLayout>
